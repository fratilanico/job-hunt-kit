{
  "name": "job-hunt-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Job-hunting toolkit for Claude Code / Codex: discovery, triage, CV themes, cover letters, ATS apply driver, tracker.",
  "scripts": {
    "cv": "node cv/build.mjs",
    "cv:check": "node cv/ats-check.mjs",
    "cv:previews": "node cv/build.mjs --previews",
    "probe": "node jobs/apply.mjs probe",
    "apply": "node jobs/apply.mjs run"
  },
  "dependencies": {
    "playwright": "1.61.0",
    "yaml": "2.6.1"
  }
}
